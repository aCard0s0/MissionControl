# Copy to `.env` beside compose.yml and fill in. `.env` is gitignored; this file
# is not — never paste a key into this one.
#
#   cp deploy/.env.example deploy/.env
#
# THIS FILE IS FOR COMPOSE INTERPOLATION ONLY. Compose reads it to fill in ${...}
# in compose.yml; it does not hand it to any container. Do not add it to a
# service `env_file:` — that would dump every line below, TS_AUTHKEY included,
# into that container's environment, readable from /proc/self/environ by
# anything that gets code execution in it. The application's own secret
# (MC_SECRET_KEY) lives in ../.mission-control.env, which ./mc generates.
#
# Verify the separation holds after any edit — expect exactly 1:
#   docker compose -p mission-control -f deploy/compose.yml config | grep -c TS_AUTHKEY

# ── identity ────────────────────────────────────────────────────────────────
# Compose project name. Prefixes container and volume names. ./mc always passes
# -p mission-control, so change this only if you also change ./mc.
PROJECT_NAME=mission-control

# The machine name on your tailnet, and therefore the URL:
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=mission-control

# REQUIRED — no default. Your tailnet's MagicDNS suffix, without the hostname:
# the part after the first dot in <TS_HOSTNAME>.<...>.ts.net. Find it with
#   ./mc status          # url: https://mission-control.<this-part>
# It is required because the app's CORS allowlist is built from it, and a wrong
# or missing value fails at deploy time rather than as a 403 on the first click.
TS_TAILNET=tailnet-name.ts.net

# REQUIRED — no default. Pin the sidecar; `latest` and `stable` both move under
# you. Tags: https://hub.docker.com/r/tailscale/tailscale/tags
TS_IMAGE_TAG=v1.98.4

# ── auth ────────────────────────────────────────────────────────────────────
# REQUIRED — no default. Mint at https://login.tailscale.com/admin/settings/keys
#
# Make it REUSABLE and TAGGED (tag:server). Tagged nodes never expire, and
# acl.hujson targets tag:server — an untagged node matches no rule there and
# falls back to whatever your tailnet default policy allows.
#
# The key is spent ONCE: node identity lives in the tailscale-state volume and
# TS_AUTH_ONCE=true stops the container re-authenticating on every start.
# Rotating the key needs no redeploy.
#
# Do NOT use an ephemeral key. Ephemeral nodes are deleted on disconnect, which
# fights the state volume and burns a new node (mission-control-1, -2, …) on
# every restart, each holding the MagicDNS name your URL and ACL point at.
TS_AUTHKEY=tskey-auth-…

# Extra flags for `tailscale up`. The common one, when the key is untagged:
#   TS_EXTRA_ARGS=--advertise-tags=tag:server
# Adding this to an already-authenticated node does nothing on its own — see
# the re-auth sequence in docs/deployment-tailscale.md.
TS_EXTRA_ARGS=

# ── exposure ────────────────────────────────────────────────────────────────
# Picks which tailscale/serve-*.json the sidecar loads.
#
#   https   TLS on :443 with a real Let's Encrypt cert, tailnet only.
#   funnel  The same listener, additionally published to the PUBLIC INTERNET.
#
# Keep this on `https`. Mission Control has no authentication of its own and
# mounts the host docker socket; funnel would put a root-equivalent dashboard on
# the open internet, and Serve sends no identity headers on funnel requests, so
# there is nothing the app could gate on even if it wanted to.
#
# Both modes require HTTPS Certificates enabled for the tailnet (admin console
# -> DNS -> HTTPS Certificates). There is no plaintext mode: ${TS_CERT_DOMAIN}
# is derived from the node's cert domain, so with certificates off the handler
# matches no request and the node comes up healthy while serving nothing.
#
# Either way the tailnet ACL must name port 443 — see acl.hujson. An ACL on the
# wrong port locks you out with a plain timeout and no log line.
TS_SERVE_MODE=https

# ── local host port ─────────────────────────────────────────────────────────
# Off by default: the tailnet is the access path, and a host port is a second
# door that the ACL does not guard and that Serve's identity headers do not
# cover.
#
# `true` makes ./mc append -f compose.local.yml. Compose cannot express this
# with a variable alone, which is why it is an override file.
LOCAL_PORT_ENABLED=false
LOCAL_PORT=8080
# Loopback is the intended value. See the warning in compose.local.yml before
# widening it.
LOCAL_BIND=127.0.0.1

# ── ollama (compose profile "ollama", opt-in) ───────────────────────────────
# Host port for Hermes agent containers running outside this stack.
OLLAMA_PORT=11434
# 0.0.0.0 is docker's implicit default for a published port and is what agent
# containers need on a Linux host with --add-host=host.docker.internal:host-gateway.
# On Docker Desktop, 127.0.0.1 also works and is tighter.
OLLAMA_BIND=0.0.0.0
